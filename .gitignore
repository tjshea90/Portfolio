# Android/Gradle build output — the release APK we deliberately keep lives
# under releases/, which none of this touches.
build/
.gradle/
.kotlin/
app/build/
local.properties

# The old Cowork-native checkpoint state (superseded by tools/ + CHECKPOINT.md).
.ck/
__pycache__/

# Local secrets — keep real credentials out of the repo entirely; see
# tools/secretscan.sh and CLAUDE.md's "Credentials" section.
.env
.env.local
.env.*.local

# The release-signing keystore. This is NOT a build artifact — it is
# intentionally excluded from git (the platform's own safety checks refuse
# to commit it even to this private repo). It must exist locally at this
# path before ship.sh or ./gradlew assembleRelease will work. See BRIEF.md
# ("the keystore is irreplaceable") for why it can never be regenerated.
app/sideload.jks

# OS / editor noise
.DS_Store
*.log
