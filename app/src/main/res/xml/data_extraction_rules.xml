<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ (dataExtractionRules), which CAN tell the two cases apart - and they deserve
  different answers:

    cloud-backup     the database leaves the device and sits in Google's backup. The API
                     keys are in it, so it is excluded. See backup_rules.xml.
    device-transfer  a direct phone-to-phone move, which never leaves the user's hands and
                     is exactly the case where TJ would want his whole portfolio to come
                     across. Everything is included (an empty element means "back up all").
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="portfolio.db" />
        <exclude domain="database" path="portfolio.db-journal" />
        <exclude domain="database" path="portfolio.db-wal" />
        <exclude domain="database" path="portfolio.db-shm" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
