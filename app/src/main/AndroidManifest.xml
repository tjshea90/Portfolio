<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Portfolio">
        <!--
          ROTATION IS HANDLED IN COMPOSE, NOT BY A RESTART (Round 64).

          TJ asked for a chart that "can rotate landscape or portrait with the phone
          sensors". Without this line every rotation DESTROYS and recreates the activity,
          and this app's navigation is a `remember`ed stack inside the composition - so
          turning the phone would have closed the stock, thrown away the zoom window and
          landed back on the portfolio list. Declaring the configuration changes the
          activity handles keeps the process, the composition and everything in it, and
          Compose re-lays-out for the new size on its own, which is what it is for.

          `screenSize` and `smallestScreenSize` are the two that actually matter for a
          rotation on a modern device; the rest are listed because each one left out is a
          different way to lose the screen (a font-scale change in Settings, dark mode
          being toggled, a keyboard appearing). `fontWeightAdjustment` is the accessibility
          "Bold text" switch - left out of the first version of this line, and it destroyed
          the navigation stack exactly like the others would have.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|fontWeightAdjustment|colorMode|layoutDirection|locale"
            android:theme="@style/Theme.Portfolio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          SHARE -> PORTFOLIO (2026-09-23b). Claude's answer file, shared or opened with this
          app, lands in ShareImportActivity - a no-UI trampoline that copies it and hands it
          to MainActivity, which imports it and opens the matching screen. See that class for
          why it is a separate activity rather than a filter on MainActivity.

          The MIME list is wide on purpose: the Claude app, file managers and download
          managers label the same .md file text/markdown, text/plain, text/x-markdown or
          application/octet-stream depending on who is asking. What is actually inside is
          checked on import (SharedAnswer.classify), and anything that is not an answer is
          rejected in plain language, so being offered for an unrelated file costs nothing.
        -->
        <activity
            android:name=".ShareImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          The other direction: every "Make prompt file" button hands its prompt to the share
          sheet through this provider, which exposes ONLY cache/shared/ (res/xml/share_paths.xml)
          and only by per-file, per-share read grants - it is not exported.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
